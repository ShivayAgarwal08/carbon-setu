# CARbon Setu Frontend Environment Variables
# Copy this file to .env and fill in real values

# Backend API URL
# For local development with Vite dev proxy (recommended default):
# VITE_API_BASE_URL="http://localhost:3001/api"
# Or leave blank to automatically use relative '/api' proxy

# For Vercel production deployment:
# VITE_API_BASE_URL="https://carbon-setu-api.onrender.com/api"
# (VITE_API_URL is also supported interchangeably)
VITE_API_BASE_URL="http://localhost:3001/api"

# App name (public, non-secret)
VITE_APP_NAME="CARbon Setu"
