# CARbon Setu (कार्बन सेतु) — Monorepo Root Environment Configuration Template
# -------------------------------------------------------------------------
# INSTRUCTIONS:
# This file serves as documentation for all environment variables used across
# the platform. Do not add real secrets to this file.
#
# For local development:
# 1. Server configuration: copy server/.env.example to server/.env
# 2. Client configuration: copy client/.env.example to client/.env

# =========================================================================
# BACKEND ENVIRONMENT VARIABLES (Configure in server/.env)
# =========================================================================

# Database Connection (PostgreSQL or Neon Serverless Postgres)
# Example: postgresql://postgres:postgres@localhost:5433/carbon_setu?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/carbon_setu?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/carbon_setu?schema=public"

# Google Gemini AI Integration
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
# Leave empty to run the built-in deterministic heuristic rule engine
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.0-flash"

# Cryptographic Session & JWT Security
# Generate secure 64-character random strings (e.g., openssl rand -hex 32)
SESSION_SECRET="change-this-to-a-secure-random-64-character-string"
JWT_SECRET="change-this-to-another-secure-random-64-character-string"

# Network & CORS Configuration
FRONTEND_URL="http://localhost:5173"
PORT=3001
NODE_ENV="development"

# Initial Bootstrap Credentials (Used during database seeding)
ADMIN_EMAIL="admin@carbonsetu.in"
ADMIN_PASSWORD="ChangeThisPasswordInProduction@2026"

# =========================================================================
# FRONTEND ENVIRONMENT VARIABLES (Configure in client/.env)
# =========================================================================

# Backend API Endpoint
VITE_API_BASE_URL="http://localhost:3001/api"
VITE_APP_NAME="CARbon Setu"
