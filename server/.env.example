# CARbon Setu Backend Environment Variables
# Copy this file to .env and fill in real values

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Google Gemini AI
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.0-flash"

# Authentication
SESSION_SECRET="generate-a-random-64-char-string-here"
JWT_SECRET="generate-another-random-64-char-string-here"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Server
NODE_ENV="development"
PORT=3001

# Admin bootstrap (used only for initial admin creation)
ADMIN_EMAIL="admin@carbonsetu.in"
ADMIN_PASSWORD="change-this-secure-password"

# Meta WhatsApp Cloud API (Optional: leave empty to disable)
WHATSAPP_APP_SECRET=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""

# Bhashini ULCA / Dhruva AI (Optional: leave empty for browser Web Speech API fallback)
BHASHINI_USER_ID=""
BHASHINI_API_KEY=""
BHASHINI_PIPELINE_ID=""
BHASHINI_INFERENCE_URL=""
